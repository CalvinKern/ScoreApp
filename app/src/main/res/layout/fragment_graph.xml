<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/graphAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:liftOnScrollTargetViewId="@id/graphContainer"
        >

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/graphToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationContentDescription="@string/navigateUp"
            app:popupTheme="@style/AppTheme.PopupOverlay"
            tools:subtitle="@string/graphSubtitle"
            tools:title="@string/gameCreateTitle"
            />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/graphContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/fab_margin"
            >

            <!-- Everyone's total, best standing first -->
            <TextView
                android:id="@+id/graphPodiumLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/graphPodiumLabel"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/podiumChart"
                android:layout_width="match_parent"
                android:layout_height="@dimen/graph_podium_height"
                android:layout_marginTop="@dimen/fab_margin"
                />

            <TextView
                android:id="@+id/graphByRoundsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fab_margin"
                android:accessibilityHeading="true"
                android:text="@string/graphByRoundsLabel"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/gameChart"
                android:layout_width="match_parent"
                android:layout_height="@dimen/graph_rounds_height"
                android:layout_marginTop="@dimen/fab_margin"
                />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
